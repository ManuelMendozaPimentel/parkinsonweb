{
  "version": 2,
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/mpwebapp/browser",
  "framework": "angular",
  "functions": {
    "dist/mpwebapp/server/server.mjs": {
      "includeFiles": "dist/mpwebapp/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}